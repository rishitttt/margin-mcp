# Blank credentials only; never commit actual values.
# The runtime reads exported environment variables; it does NOT auto-load this file.
BHARATSTOCK_API_KEY=
DRISHTI_API_KEY=
MARGIN_MODE=synthetic
# Process-local ceilings, not current account balances or daily guarantees.
MARGIN_BHARATSTOCK_REQUESTS=20
MARGIN_DRISHTI_REQUESTS=30
MARGIN_DRISHTI_CREDITS=20
# Explicit reviewed live-test opt-in, comma-separated full registry names.
MARGIN_ENABLE_OPERATIONS=
MARGIN_SYNTHETIC_SCENARIO=none
